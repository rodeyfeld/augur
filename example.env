# Copy this file to .env and update the values as needed
# cp example.env .env

# --- Secrets ---
AUGUR_SECRET_KEY=my-secret
AUGUR_DB_PASSWORD=atlas_password

# --- Configs ---
# Django settings
AUGUR_DEBUG=True
AUGUR_ALLOWED_HOSTS=localhost,127.0.0.1,augur-django-web-1,augur-django-web-1:8000
AUGUR_CORS_ALLOWED_ORIGINS=http://localhost:5173
AUGUR_SESSION_COOKIE_SECURE=False
AUGUR_CSRF_COOKIE_SECURE=False
AUGUR_SECURE_SSL_REDIRECT=False

# Postgres
AUGUR_DB_NAME=augur
AUGUR_DB_USER=atlas_user
AUGUR_DB_HOST=postgres
AUGUR_DB_PORT=5432


# Sentinel archive database (ephemeris in prod). Leave AUGUR_ARCHIVE_DB_HOST unset to
# keep the archive in the database above; other AUGUR_ARCHIVE_DB_* default to the
# AUGUR_DB_* values. When set, also run `manage.py migrate --database=archive`.
# AUGUR_ARCHIVE_DB_HOST=ephemeris
# AUGUR_ARCHIVE_DB_NAME=ephemeris
# AUGUR_ARCHIVE_DB_USER=postgres
# AUGUR_ARCHIVE_DB_PASSWORD=
# AUGUR_ARCHIVE_DB_PORT=5432
